# Initial cache for the Windows XP build (Pentium 4, 1 GB RAM, Radeon 9600 / SM2.0).
# Features are off when their library isn't built for this target yet, or when the hardware
# can't run them. Re-enable as `deps.sh` grows.

set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)

set(WITH_INSTALL_PORTABLE ON CACHE BOOL "" FORCE)
set(WITH_BUILDINFO OFF CACHE BOOL "" FORCE)
set(WITH_BLENDER_THUMBNAILER OFF CACHE BOOL "" FORCE)
set(WITH_WINDOWS_BUNDLE_CRT OFF CACHE BOOL "" FORCE)
set(WITH_WINDOWS_RELEASE_PDB OFF CACHE BOOL "" FORCE)
set(WITH_GTESTS OFF CACHE BOOL "" FORCE)
set(WITH_STRICT_BUILD_OPTIONS OFF CACHE BOOL "" FORCE)

# Win32 windows drawn with the Direct3D 9 backend.
set(WITH_HEADLESS OFF CACHE BOOL "" FORCE)
set(WITH_D3D9_BACKEND ON CACHE BOOL "" FORCE)
set(WITH_PYTHON ON CACHE BOOL "" FORCE)
set(PYTHON_VERSION 3.13 CACHE STRING "" FORCE)
# Not built for XP yet: NumPy, requests, zstandard.
set(WITH_PYTHON_NUMPY OFF CACHE BOOL "" FORCE)
set(WITH_PYTHON_INSTALL_NUMPY OFF CACHE BOOL "" FORCE)
set(WITH_PYTHON_INSTALL_REQUESTS OFF CACHE BOOL "" FORCE)
set(WITH_PYTHON_INSTALL_ZSTANDARD OFF CACHE BOOL "" FORCE)
set(WITH_OPENGL_BACKEND OFF CACHE BOOL "" FORCE)
set(WITH_VULKAN_BACKEND OFF CACHE BOOL "" FORCE)
set(WITH_XR_OPENXR OFF CACHE BOOL "" FORCE)
set(WITH_INPUT_NDOF OFF CACHE BOOL "" FORCE)

# Renderers: Cycles on the CPU with an SSE2 kernel (Pentium 4), EEVEE needs far more than SM2.0.
# Embree, OSL (LLVM), path guiding (OpenPGL) and denoising (OpenImageDenoise) need 64-bit or
# SSE4, Cycles uses its own BVH.
set(WITH_CYCLES ON CACHE BOOL "" FORCE)
set(WITH_CYCLES_KERNEL_SSE2 ON CACHE BOOL "" FORCE)
# Measured on the Pentium 4: -O3 renders ~5% faster than -O2. Profile guided builds and SSE3 gain
# nothing, the SSE2 kernel is on par with the scalar one (half width SSE units).
set(CYCLES_KERNEL_FLAGS "-O3" CACHE STRING "" FORCE)
set(WITH_CYCLES_EMBREE OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_OSL OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_PATH_GUIDING OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_DEVICE_CUDA OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_DEVICE_OPTIX OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_DEVICE_HIP OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_DEVICE_HIPRT OFF CACHE BOOL "" FORCE)
set(WITH_CYCLES_DEVICE_ONEAPI OFF CACHE BOOL "" FORCE)
set(WITH_HYDRA OFF CACHE BOOL "" FORCE)
set(WITH_FREESTYLE OFF CACHE BOOL "" FORCE)

# TBB's runtime needs Vista+. Cycles uses a small thread pool of its own instead.
set(WITH_TBB OFF CACHE BOOL "" FORCE)

# Libraries not built for XP (yet).
set(WITH_OPENVDB OFF CACHE BOOL "" FORCE)
set(WITH_NANOVDB OFF CACHE BOOL "" FORCE)
set(WITH_USD OFF CACHE BOOL "" FORCE)
set(WITH_MATERIALX OFF CACHE BOOL "" FORCE)
set(WITH_ALEMBIC OFF CACHE BOOL "" FORCE)
set(WITH_OPENIMAGEDENOISE OFF CACHE BOOL "" FORCE)
set(WITH_GMP OFF CACHE BOOL "" FORCE)
set(WITH_MANIFOLD OFF CACHE BOOL "" FORCE)
set(WITH_POTRACE OFF CACHE BOOL "" FORCE)
set(WITH_HARU OFF CACHE BOOL "" FORCE)
set(WITH_FFTW3 OFF CACHE BOOL "" FORCE)
set(WITH_PUGIXML OFF CACHE BOOL "" FORCE)
set(WITH_LIBMV OFF CACHE BOOL "" FORCE)
set(WITH_DRACO OFF CACHE BOOL "" FORCE)
set(WITH_MESHOPTIMIZER OFF CACHE BOOL "" FORCE)
set(WITH_IMAGE_OPENJPEG OFF CACHE BOOL "" FORCE)
set(WITH_IMAGE_WEBP OFF CACHE BOOL "" FORCE)
set(WITH_CODEC_FFMPEG OFF CACHE BOOL "" FORCE)
set(WITH_CODEC_SNDFILE OFF CACHE BOOL "" FORCE)
set(WITH_AUDASPACE OFF CACHE BOOL "" FORCE)
set(WITH_OPENAL OFF CACHE BOOL "" FORCE)
set(WITH_SDL OFF CACHE BOOL "" FORCE)
set(WITH_WASAPI OFF CACHE BOOL "" FORCE)
set(WITH_INTERNATIONAL OFF CACHE BOOL "" FORCE)

# In-tree, but heavy: enable once the base works.
set(WITH_MOD_FLUID OFF CACHE BOOL "" FORCE)
set(WITH_MOD_OCEANSIM OFF CACHE BOOL "" FORCE)
set(WITH_QUADRIFLOW OFF CACHE BOOL "" FORCE)
set(WITH_BULLET OFF CACHE BOOL "" FORCE)
